UnlitTwoTexture
{
"%tooltexture" "ti/smoke100"
$basetexture "ti/smoke100"
$texture2 "ti/smoke100_anim"
$additive 1
$nocull 1
$no_fullbright 1
$nofog 1
$scale "[1 1]"
$scroll "[2 2]"
$color "{0 100 255}"
Proxies
{
LinearRamp
{
resultVar "$scroll[0]"
rate -.01
}
LinearRamp
{
resultVar "$scroll[1]"
rate .01
}
TextureTransform
{
scaleVar $scale
translateVar $scroll
resultVar $basetexturetransform
}
}
}
