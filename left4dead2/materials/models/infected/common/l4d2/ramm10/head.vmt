"VertexlitGeneric"
{
	"$basetexture" "models\infected\common\l4d2\ramm10\head"
	"$bumpmap" "models\infected\common\l4d2\ramm10\head_nm"



	"$phongexponenttexture" "models\infected\common\l4d2\ramm10\expo"



$phong                      1
$phongboost                10
$phongfresnelranges "[.4 .6 1]"
$phongtint               "[0.7 0.7 0.7]"
$halflambert 1
$envmap                     env_cubemap

$envmapfresnel              1
$envmapFresnelMinMaxExp "[.4 1 .4]"

$envmaptint                 "[.04 .04 .04]"

$normalmapalphaenvmapmask 1



$color "[0 0 0]"
$color2 "[0 0 0]"
$blendtintbybasealpha 1
$blendtintcoloroverbase 1

	"$colorfix" "{255 255 255}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}



