"VertexLitGeneric"
{
	"$baseTexture"		"models/r2l/blood_man/blood_man_d"
	"$bumpmap"			"models/r2l/blood_man/blood_man_n"
	$detail				"models/r2l/blood_man/horror_blood"
	$AmbientOcclColor "[0.16 0 0]"
	$ambientocclusion "1"
	$nocull "1"
	$halflambert "1"
	$model "1"

	$phong "1"
	$phongboost "3"

	$phongfresnelranges "[.2 .5 5]"
	$allowdiffusemodulation "0"
	$detailscale "0.5"
	$detailblendfactor "1"
	$detailblendmode "0.5"
	$detailAmount "1"
	$selfillium "1"
	$cloakpassenabled "1"
	$cloakcolortint "[24 0 0]"
	$cloakfactor "0.26"
	$refractamount "0.25"

	Proxies
	{
		"Sine"
		{
		"sineperiod" "2"
		"sinemin" "0.05"
		"sinemax" "0.1"
		"timeoffset" "0.1"
		"srcVar1" "$cloakcolortint"
		"resultVar" "$cloakcolortint[0]"
		}
		"Sine"
		{
		"sineperiod" "3"
		"sinemin" "0.06"
		"sinemax" "0.16"
		"timeoffset" "0.2"
		"srcVar2" "$cloakcolortint"
		"resultVar" "$cloakcolortint[1]"
		}
	}
}
