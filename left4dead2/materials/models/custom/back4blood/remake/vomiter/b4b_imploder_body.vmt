$phong 1
$phongboost 0.2
$phongtint "[.62 .72 1]"
$halflambert 0
$phongfresnelranges "[.2 .2 .2]"
$phongexponent 4
$nodecal 1
$ambientocclusion 1
$diffuseexp "1.5"
$detail "models/custom/back4blood/remake/Vomiter/Burn_B4B"
$seamless_detail 1
$seamless_scale ".005"
$detailscale 4
$detailblendfactor .001
$detailblendmode 2
$bbqamount 1
$BurnLevel 0.0
