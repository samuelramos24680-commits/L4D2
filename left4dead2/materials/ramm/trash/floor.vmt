"VertexlitGeneric"
{
	"$basetexture" "ramm\trash\floor"
	"$bumpmap""ramm\trash\floor_nm"


	"$phongexponenttexture" "ramm\trash\floor_e"


$phong                      1
$phongboost                10
$phongfresnelranges "[.4 .6 1]"
$phongtint               "[0.7 0.7 0.7]"
$halflambert 1
$envmap                     env_cubemap

$envmapfresnel              1
$envmapFresnelMinMaxExp "[.4 1 .4]"

$envmaptint                 "[.04 .04 .04]"

$normalmapalphaenvmapmask 1

$translucent 1 

}







